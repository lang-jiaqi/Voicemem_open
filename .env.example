# === Required ===
# OpenAI-compatible API used for VoiceMem extraction, classification, and retrieval.
OPENAI_API_KEY=

# Gemini Live voice replies (service/tts.py). Leave blank to disable voice output.
GEMINI_API_KEY=

# === Planned desktop cloud mode (no local GPU) ===
# The desktop app stores this user-owned key in macOS Keychain. Do not commit a key.
# Cloud voice and text costs are billed to the user's DashScope account.
# VOICEMEM_RUNTIME=cloud
# DASHSCOPE_API_KEY=
# DASHSCOPE_REGION=singapore
# DASHSCOPE_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# DASHSCOPE_EMBEDDING_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/embeddings
# DASHSCOPE_MEMORY_MODEL=qwen-flash
# DASHSCOPE_CHAT_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions

# === Optional ===
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Real-time acoustic emotion: sensevoice (default, reuses ASR) or emotion2vec (legacy).
# EMOTION_BACKEND=sensevoice

# Memory storage (default: repository-root/memory/)
# VOICEMEM_MEMORY_ROOT=

# Downloaded ASR/speaker/VAD models (default: service/models/)
# VOICEMEM_MODELS_DIR=

# WebSocket server port (default: 8771)
# VOICEMEM_WS_PORT=8771

# Gemini Live model and voice
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_VOICE=Kore
