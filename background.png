<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>VoiceMem — memory graph</title>
<style>
  :root{
    --ink:#f2f4f8;
    --dim:#7d8496;
    --line:rgba(255,255,255,.14);
    --blue:#4aa8f0;
    --rose:#ff3d8b;
    --violet:#a583ff;
    --mint:#58e08d;
    --pink:#ff5fa2;
    --amber:#ff9a3c;
    --leaf:#4ade80;
    --brass:#e0a94a;
    --disc:170px;
    --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;
    --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0;background:#000;color:var(--ink);
    font-family:var(--mono);
    overflow:hidden;
    -webkit-font-smoothing:antialiased;
  }
  #shell{
    position:fixed;inset:0;display:flex;flex-direction:column;
    padding:clamp(28px,5vh,60px) clamp(14px,3vw,40px) calc(var(--disc) - 4px);
  }

  /* ---------- masthead ---------- */
  header{display:flex;align-items:center;gap:clamp(14px,2vw,26px);flex:0 0 auto;position:relative;z-index:4}
  header .rule{flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--line) 22%,var(--line) 78%,transparent)}
  header h1{
    margin:0;font-weight:400;font-size:clamp(25px,3.3vw,44px);
    letter-spacing:.40em;text-indent:.40em;white-space:nowrap;
    color:#fff;text-shadow:0 0 34px rgba(180,205,255,.42);
  }

  /* ---------- stage ---------- */
  main{flex:1 1 auto;position:relative;display:flex;align-items:center;justify-content:center;min-height:0}
  #stage{position:relative;width:100%;height:100%}
  #brain{
    position:absolute;left:0;top:0;width:100%;height:100%;
    object-fit:fill;mix-blend-mode:screen;
    filter:brightness(.92) contrast(1.06);
    opacity:0;transition:opacity 1.4s ease .1s;
    pointer-events:none;user-select:none;
  }
  #brain.in{opacity:1}
  /* one fixed, viewport-sized canvas draws the graph, the beams and the platter */
  #fx{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:2;pointer-events:none}
  /* one stacking context: cortex 0 < canvas 2 < legends 3 < chrome 4 < bar 6 < card 7 */

  /* ---------- hemisphere legends ---------- */
  .side{
    position:absolute;top:50%;transform:translateY(-50%);
    display:flex;flex-direction:column;gap:clamp(22px,3.3vh,36px);z-index:3;
    pointer-events:auto;
  }
  .side.l{left:clamp(14px,7vw,152px);align-items:flex-start}
  .side.r{right:clamp(14px,7vw,152px);align-items:flex-end}
  .side h2{
    margin:0 0 6px;font-family:var(--serif);font-style:italic;font-weight:400;
    font-size:clamp(15px,1.65vw,22px);letter-spacing:.01em;color:#e8ecf5;white-space:nowrap;
  }
  .side.l h2 em{font-style:italic;color:#7fb2e8}
  .side.r h2 em{font-style:italic;color:#e879a8}
  .key{
    display:flex;align-items:center;gap:11px;cursor:default;
    font-family:var(--serif);font-style:italic;font-size:clamp(13.5px,1.15vw,16.5px);
    color:var(--dim);transition:color .35s ease,opacity .35s ease;padding:4px 0;
  }
  .side.r .key{flex-direction:row-reverse}
  .key:hover{color:#fff}
  .key .g{width:13px;height:13px;flex:0 0 13px;opacity:.85;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
  .key:hover .g{transform:scale(1.35)}
  .key .g svg{display:block;overflow:visible}

  /* ---------- frosted action bar ---------- */
  .glass{
    position:absolute;left:50%;bottom:1%;transform:translateX(-50%);
    display:flex;z-index:6;border-radius:999px;overflow:hidden;
    border:1px solid rgba(255,255,255,.18);
    background:rgba(11,15,25,.50);
    backdrop-filter:blur(26px) saturate(150%) brightness(.5);
    -webkit-backdrop-filter:blur(26px) saturate(150%) brightness(.5);
    box-shadow:
      0 20px 54px -20px rgba(0,0,0,.95),
      inset 0 1px 0 rgba(255,255,255,.18),
      inset 0 -1px 0 rgba(255,255,255,.05),
      0 0 46px -16px rgba(120,170,255,.4);
  }
  .glass > *{
    appearance:none;-webkit-appearance:none;background:none;border:0;
    border-right:1px solid rgba(255,255,255,.11);
    font-family:var(--mono);font-size:clamp(10.5px,.92vw,13px);
    letter-spacing:.17em;text-transform:uppercase;
    color:#cdd5e4;text-decoration:none;cursor:pointer;
    padding:12px clamp(15px,1.9vw,30px);
    display:flex;align-items:center;gap:9px;white-space:nowrap;
    transition:background .3s ease,color .3s ease;
  }
  .glass > *:last-child{border-right:0}
  .glass > *:hover{background:rgba(255,255,255,.12);color:#fff}
  .glass .d{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.6;box-shadow:0 0 9px currentColor}
  .glass .d.b{background:var(--blue);box-shadow:0 0 9px var(--blue)}
  .glass .d.p{background:var(--pink);box-shadow:0 0 9px var(--pink)}
  .glass .d.g{background:var(--leaf);box-shadow:0 0 9px var(--leaf)}

  /* ---------- memory card ---------- */
  #card{
    position:fixed;left:0;top:0;width:214px;z-index:7;
    border:1px solid rgba(255,255,255,.82);
    background:rgba(4,5,8,.80);
    backdrop-filter:blur(9px) saturate(120%);
    -webkit-backdrop-filter:blur(9px) saturate(120%);
    padding:11px 12px 10px;
    opacity:0;transform:translate3d(-999px,-999px,0);
    transition:opacity .22s ease;
    will-change:transform,opacity;pointer-events:none;
    box-shadow:0 0 0 1px rgba(0,0,0,.9),0 18px 50px -18px rgba(0,0,0,1);
  }
  #card.on{opacity:1}
  #card .eb{display:flex;align-items:center;gap:7px;margin-bottom:9px}
  #card .sw{width:7px;height:7px;border:1.4px solid #fff;flex:0 0 7px}
  #card .kd{font-size:9.5px;letter-spacing:.24em;color:#fff;text-transform:uppercase}
  #card .id{margin-left:auto;font-size:9.5px;letter-spacing:.1em;color:#6c7382}
  #card .bars{display:flex;flex-direction:column;gap:6px;margin-bottom:11px}
  #card .bars i{
    display:block;height:6px;border-radius:1px;
    background:linear-gradient(90deg,rgba(255,255,255,.07),rgba(255,255,255,.16),rgba(255,255,255,.07));
    background-size:220% 100%;animation:sweep 2.6s linear infinite;
  }
  #card .bars i:nth-child(2){animation-delay:.18s}
  #card .bars i:nth-child(3){animation-delay:.36s}
  @keyframes sweep{from{background-position:120% 0}to{background-position:-120% 0}}
  #card .ft{
    display:flex;justify-content:space-between;font-size:9px;letter-spacing:.14em;
    color:#5d6472;border-top:1px solid rgba(255,255,255,.14);padding-top:7px;
  }

  /* ---------- footer ---------- */
  footer{flex:0 0 auto;margin-top:8px;position:relative;z-index:4}
  .ticks{
    height:9px;
    background:repeating-linear-gradient(90deg,var(--line) 0 1px,transparent 1px 11px);
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
    opacity:.75;
  }
  .why{text-align:center;font-size:10.5px;letter-spacing:.36em;color:#5f6878;padding-top:13px}
  .facts{display:flex;justify-content:center;gap:clamp(16px,3.2vw,56px);padding-top:11px;flex-wrap:wrap}
  .facts span{position:relative;z-index:1;font-size:clamp(12.5px,1.1vw,16px);color:#c4cbda;letter-spacing:.035em;white-space:nowrap}
  .facts span::before,.why::before{
    content:'';position:absolute;inset:-17px -24px;z-index:-1;pointer-events:none;
    background:radial-gradient(ellipse at center,
      rgba(0,0,0,1) 0%, rgba(0,0,0,.97) 42%, rgba(0,0,0,.70) 68%, rgba(0,0,0,0) 100%);
    opacity:0;transition:opacity .55s ease;
  }
  .why{position:relative;z-index:1}
  .why::before{inset:-11px -34px}
  body.lit .facts span::before,body.lit .why::before{opacity:1}
  .facts b{font-weight:400;color:#fff}
  .facts em{font-family:var(--serif);font-style:italic;color:#a2b8d8}
  .facts .ck{color:#6fe0a0}

  .hint{
    position:absolute;left:50%;bottom:1.2%;transform:translateX(-50%);
    font-size:10px;letter-spacing:.2em;color:#4d545f;z-index:4;
    animation:fade 6s ease 3.4s forwards;pointer-events:none;
  }
  @keyframes fade{to{opacity:0}}

  @media (max-width:1000px){
    .side{display:none}
    header h1{letter-spacing:.28em;text-indent:.28em}
    #card{width:186px}
    .glass > *{padding:11px 15px;letter-spacing:.12em}
  }
  @media (prefers-reduced-motion:reduce){
    #card .bars i{animation:none}
    .hint{animation:none}
  }
</style>
</head>
<body>
<div id="shell">
  <canvas id="fx"></canvas>
  <div id="card" aria-hidden="true">
    <div class="eb"><span class="sw" id="c-sw"></span><span class="kd" id="c-kd">entity</span><span class="id" id="c-id">#0000</span></div>
    <div class="bars"><i style="width:88%"></i><i style="width:96%"></i><i style="width:54%"></i></div>
    <div class="ft"><span id="c-src">voice · 00:00</span><span>— — —</span></div>
  </div>
  <header>
    <div class="rule"></div>
    <h1>VoiceMem</h1>
    <div class="rule"></div>
  </header>

  <main>
    <div class="side l">
      <h2><em>Informative</em> Left Brain</h2>
      <div class="key" data-k="entity"><span class="g"><svg width="13" height="13" viewBox="0 0 11 11"><g fill="none" stroke="#4aa8f0" stroke-width="1.2"><circle cx="5.5" cy="5.5" r="1.6"/><circle cx="5.5" cy="5.5" r="4.6" stroke-dasharray="1.4 1.9"/></g></svg></span>Entities</div>
      <div class="key" data-k="person"><span class="g"><svg width="13" height="13" viewBox="0 0 11 11"><g fill="none" stroke="#a583ff" stroke-width="1.2"><circle cx="5.5" cy="3.4" r="2.2"/><path d="M1.6 10.2c.6-2.4 2.1-3.6 3.9-3.6s3.3 1.2 3.9 3.6"/></g></svg></span>People</div>
      <div class="key" data-k="know"><span class="g"><svg width="13" height="13" viewBox="0 0 11 11"><g fill="none" stroke="#58e08d" stroke-width="1.2"><path d="M5.5.9 10 3.4v5.1L5.5 11 1 8.5V3.4z"/><path d="M5.5 5.9 10 3.4M5.5 5.9 1 3.4M5.5 5.9V11"/></g></svg></span>Knowledge</div>
    </div>

    <div id="stage">
      <img id="brain" alt="" src="./images/background.png" />
      <div class="glass">
        <button type="button" id="btn-explore"><span class="d b"></span>Explore</button>
        <a href="#" id="btn-code"><span class="d p"></span>Code</a>
        <a href="#" id="btn-report"><span class="d g"></span>Technical Report</a>
      </div>
    </div>

    <div class="side r">
      <h2><em>Emotional</em> Right Brain</h2>
      <div class="key" data-k="emotion"><span class="g"><svg width="13" height="13" viewBox="0 0 11 11"><path d="M5.5 9.8C2 7.6.6 5.9.9 4.1 1.2 2.5 3.4 1.6 5.5 3.6 7.6 1.6 9.8 2.5 10.1 4.1c.3 1.8-1.1 3.5-4.6 5.7z" fill="none" stroke="#ff5fa2" stroke-width="1.2"/></svg></span>Emotion</div>
      <div class="key" data-k="exper"><span class="g"><svg width="13" height="13" viewBox="0 0 11 11"><path d="M.5 5.9h2L4 2.2l2 7.1 1.4-3.4h3.1" fill="none" stroke="#ff9a3c" stroke-width="1.2" stroke-linejoin="round"/></svg></span>Experiences</div>
      <div class="key" data-k="prefer"><span class="g"><svg width="13" height="13" viewBox="0 0 11 11"><path d="m5.5.9 1.5 3.2 3.4.4-2.5 2.4.7 3.4-3.1-1.7-3.1 1.7.7-3.4L.6 4.5l3.4-.4z" fill="none" stroke="#4ade80" stroke-width="1.1" stroke-linejoin="round"/></svg></span>Preference</div>
    </div>

    <div class="hint">MOVE CURSOR OVER THE CORTEX</div>
  </main>

  <footer>
    <div class="ticks"></div>
    <div class="why">WHY VOICEMEM</div>
    <div class="facts">
      <span><b class="ck">✓</b> Vocal : <em>ID voices + print</em></span>
      <span><b class="ck">✓</b> Emotional : <em>emotion attr.</em></span>
      <span><b class="ck">✓</b> Fast : <b>160ms</b>, <b>65% reduced</b></span>
      <span><b class="ck">✓</b> Cheap : <em>top-5 only</em></span>
    </div>
  </footer>
</div>


<script>
