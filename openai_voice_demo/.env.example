# Copy to .env and fill in. Loaded by backend/config.py before `voicemem` is
# imported, so voicemem's own OPENAI_* env reads see these too.

OPENAI_API_KEY=                      # required
# OPENAI_BASE_URL=                   # optional, for an OpenAI-compatible proxy
# OPENAI_MODEL=gpt-4o-mini           # voicemem's OWN internal LLM calls (extraction/ranking) — independent of the chat model below
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- this demo's own config ---
# Speech-to-text is fully LOCAL in both modes (backend/local_asr.py, sherpa-onnx);
# the modes differ only in how the reply is produced.
# VOICE_MODE=pipeline                # pipeline | realtime (OpenAI) | qwen | doubao (Seed Realtime)
# DOUBAO_API_KEY=                    # required when VOICE_MODE=doubao
# VOICEMEM_AUDIO_NATIVE=false        # true = enable voicemem's built-in speaker/scene/emotion perception (needs the heavier install extras, see requirements.txt)
# VOICE_DEMO_USER_ID=voice_demo_user
# VOICE_DEMO_HOST=0.0.0.0
# VOICE_DEMO_PORT=8787
# VOICE_DEMO_SYSTEM_PROMPT=          # override the default assistant system prompt

# --- model choice (pipeline mode) ---
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# --- model choice (realtime mode) ---
# OPENAI_REALTIME_MODEL=gpt-realtime
